# KETJU (MSTAR chain regularisation) build additions; included by src/Makefile when KETJU_REGULARIZATION is set
KETJU_DIR = gravity/ketju
OBJS += $(KETJU_DIR)/ketju_coupling.o $(KETJU_DIR)/ketju_params.o
INCL += $(KETJU_DIR)/ketju_coupling.h $(KETJU_DIR)/ketju_proto.h $(KETJU_DIR)/ketju_particle_fields.h $(KETJU_DIR)/ketju_global_fields.h $(KETJU_DIR)/ketju_member_state.h
INCL += $(KETJU_DIR)/ketju_precompiler_logic.h
$(if $(wildcard $(KETJU_DIR)/ketju-integrator-c/include/ketju_integrator/ketju_integrator.h),,$(error KETJU: run git submodule update --init src/gravity/ketju/ketju-integrator-c))
$(if $(wildcard $(KETJU_DIR)/ketju-integrator/include/mstar/mstar.hpp),,$(error KETJU: run git submodule update --init src/gravity/ketju/ketju-integrator))
KETJU_INCL = -I$(KETJU_DIR)/ketju-integrator/include -I$(KETJU_DIR)/ketju-integrator-c/include
KETJU_LIBS = $(KETJU_DIR)/ketju-integrator/build-kokkos/libmstar.a $(KOKKOS_LIBS_PATH) $(KOKKOS_LIBS)
KETJU_LIB_DEP = $(KETJU_DIR)/ketju-integrator/build-kokkos/libmstar.a
# same Kokkos as GIZMO: the install the systype points at
KETJU_KOKKOS_ROOT ?= $(firstword $(KOKKOS_HOME_ORION) $(KOKKOS_PATH) $(TACC_KOKKOS_DIR))
CFLAGS += $(KETJU_INCL)
LIBS += $(KETJU_LIBS)
$(EXEC): | $(KETJU_LIB_DEP)
$(OBJS): | $(KETJU_LIB_DEP)
$(KETJU_DIR)/ketju-integrator/build-kokkos/libmstar.a:
	MAKEFLAGS= cmake -S $(KETJU_DIR)/ketju-integrator -B $(KETJU_DIR)/ketju-integrator/build-kokkos -DCMAKE_CXX_COMPILER=$(firstword $(CXX)) -DCMAKE_BUILD_TYPE=Release -DMSTAR_TESTS=OFF -DKokkos_ROOT=$(KETJU_KOKKOS_ROOT)
	MAKEFLAGS= cmake --build $(KETJU_DIR)/ketju-integrator/build-kokkos --target mstar -j 4
.DEFAULT_GOAL := $(EXEC)
