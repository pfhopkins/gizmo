# Select Target Computer
#
# Please copy this file to Makefile.systype and uncomment your
# system. Don't commit changes to this file unless you add support for
# a new system.
#
#############

#SYSTYPE="github-ubuntu"
#SYSTYPE="Frontera"
#SYSTYPE="MacBookCellar"
SYSTYPE="MacBookCellar_Kokkos"
#SYSTYPE="Vista"
#SYSTYPE="Expanse"
#SYSTYPE="CaltechHPC"
#SYSTYPE="RUSTY"
#SYSTYPE="RUSTY_GENOA"
#SYSTYPE="Frontier"       # OLCF, MI250X via the Kokkos HIP backend
#SYSTYPE="Frontier_CPU"   # OLCF, same source dispatched to the Kokkos OpenMP backend
#SYSTYPE="Viper_GPU"      # MPCDF Viper-GPU, MI300A APU via the Kokkos HIP backend (Kokkos built per user: see Makefile)
#SYSTYPE="Viper_CPU"      # MPCDF Viper, Zen4 nodes (or an APU node's cores) via the Kokkos OpenMP backend
#SYSTYPE="Orion_Kokkos"   # MPCDF Orion, CPU nodes via the Kokkos OpenMP backend
#SYSTYPE="Lonestar6"      # TACC, A100 via the Kokkos CUDA backend (Kokkos built per user: see Makefile)
#SYSTYPE="Lonestar6_CPU"  # TACC, same source dispatched to the Kokkos OpenMP backend
#SYSTYPE="Horizon_GPU"     # TACC Horizon GB nodes, GB200 via the Kokkos CUDA backend (Kokkos built per user: see Makefile)
#SYSTYPE="Horizon_CPU"     # TACC Horizon, same source dispatched to the Kokkos OpenMP backend
