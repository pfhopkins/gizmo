+#ifdef MOMENTUM_CONSERVATION_DIAGNOSTIC
+/*! Total system momentum (all particle types, all mass on the domain), checked ONLY at full
+    synchronization (HighestActiveTimeBin == HighestOccupiedTimeBin) for the same reason as
+    energy_budget_sync_report() above: it is the only point where every particle's Vel shares a
+    clock, so the vector sum is meaningful. Gravity, hydro, and sink accretion should all conserve
+    momentum to good approximation between syncs; if the total jumps by more than
+    MOMENTUM_CONSERVATION_MAX_JUMP_MSUN_KMS, we stop the run so the restart file written by run()
+    right after this check passes (i.e. from the previous, good global sync) can be reloaded to
+    replay the interaction that broke it.
+    Called after do_hermite_correction() (not alongside EB_SYNC_REPORT, which runs before it),
+    since sinks are Hermite-integrated here and their velocity for this step isn't final until
+    the correction is applied. */
+#define MOMENTUM_CONSERVATION_MAX_JUMP_MSUN_KMS 100.0
+/* have_prev/prev are process memory, not part of the restart file: a fresh process restarted
+   from restart files starts with have_prev=0, so without momentum_conservation_seed_from_restart()
+   below, the first full sync after any restart would silently skip its comparison (nothing to
+   compare against) instead of checking against the state the restart file was written from. */
+static int have_prev = 0;
+static double prev[3];
+void momentum_conservation_check(void)
+{
+    if(All.HighestActiveTimeBin != All.HighestOccupiedTimeBin) {return;} /* not synchronized: sum is meaningless */
+    double loc[3] = {0,0,0}, glob[3]; int i, k;
+    for(i = 0; i < NumPart; i++) {if(P[i].Mass > 0) {for(k=0;k<3;k++) {loc[k] += P[i].Mass * P[i].Vel[k];}}}
+    MPI_Allreduce(loc, glob, 3, MPI_DOUBLE, MPI_SUM, MPI_COMM_WORLD);
+    if(ThisTask == 0) {printf("Momentum (synced) t=%.10g P = %.8e %.8e %.8e\n", All.Time, glob[0], glob[1], glob[2]); fflush(stdout);} /* temporary: print every full sync, not just on violation, to check dynamics reproduce independent of diagnostic baseline validity */
+
+    /* threshold given in Msun*km/s; convert to code units so this is correct regardless of All's unit choice */
+    double threshold = MOMENTUM_CONSERVATION_MAX_JUMP_MSUN_KMS * (SOLAR_MASS_CGS/All.UnitMass_in_g) / (1.0e5/All.UnitVelocity_in_cm_per_s);
+    if(have_prev)
+    {
+        double d[3] = {glob[0]-prev[0], glob[1]-prev[1], glob[2]-prev[2]};
+        double dmag = sqrt(d[0]*d[0] + d[1]*d[1] + d[2]*d[2]);
+        if(dmag > threshold)
+        {
+            if(ThisTask == 0)
+            {
+                printf("MOMENTUM CONSERVATION VIOLATION at t=%.10g (Ti_Current=%lld):\n", All.Time, (long long)All.Ti_Current);
+                printf("  P_prev = %.8e %.8e %.8e\n", prev[0], prev[1], prev[2]);
+                printf("  P_now  = %.8e %.8e %.8e\n", glob[0], glob[1], glob[2]);
+                printf("  |dP| = %.8e code-unit (threshold %.8e = %.3g Msun*km/s)\n", dmag, threshold, MOMENTUM_CONSERVATION_MAX_JUMP_MSUN_KMS);
+                printf("  restartfiles/ holds the prior (good) global sync -- restart from it to replay this interaction.\n");
+                fflush(stdout);
+            }
+            endrun(918273);
+        }
+    }
+    for(k=0;k<3;k++) {prev[k] = glob[k];}
+    have_prev = 1;
+}
+
+/*! Called once, only on RestartFlag==1, before the main loop: seeds prev[]/have_prev from the
+    just-loaded restart state, so the first full sync reached compares against the checkpoint
+    instead of silently skipping (see have_prev comment above). */
+void momentum_conservation_seed_from_restart(void)
+{
+    double loc[3] = {0,0,0}, glob[3]; int i, k;
+    for(i = 0; i < NumPart; i++) {if(P[i].Mass > 0) {for(k=0;k<3;k++) {loc[k] += P[i].Mass * P[i].Vel[k];}}}
+    MPI_Allreduce(loc, glob, 3, MPI_DOUBLE, MPI_SUM, MPI_COMM_WORLD);
+    for(k=0;k<3;k++) {prev[k] = glob[k];}
+    have_prev = 1;
+    if(ThisTask == 0) {printf("Momentum conservation check: seeded baseline from restart at t=%.10g, P = %.8e %.8e %.8e\n", All.Time, glob[0], glob[1], glob[2]); fflush(stdout);}
+}
+#endif
+
 
