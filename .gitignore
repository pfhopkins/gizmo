# OS / editor cruft
.DS_Store
.vscode/
.idea/
*~
.#*

# AI-tool scratch dirs (same rationale as .claude/ below)
.codex/

# Build + local-run artifacts (the build and dev runs now live in src/)
*.o
GIZMO_config.h
compile_time_info.cc
src/.build_clean_stamp
/src/GIZMO
/src/Config.sh
/src/Config.sh.*
/src/Makefile.systype.*
/src/compiler_test_stdout
/src/compiler_test_stderr

# Loose test/run artifacts in src/ (and legacy repo-root copies)
/src/TREECOOL
/src/ewald_spc_table_*.dat
/src/spcool_tables/
/src/*_ics.hdf5
/src/output/
/src/run_*.log
/src/makeout
/src/makeerr
/src/makelog
/src/tstlog
/TREECOOL
/ewald_spc_table_*.dat
/output/

# compile_suite artifacts
/src/compile_suite_errors/
/src/compile_suite_output.log
/src/compile_suite_output_*.log
/src/compile_suite_results.txt

# Test artifacts
test/*/output/
test/*/output_*/
test/*/GIZMO
test/*/GIZMO_*
# the harness package source; on case-insensitive filesystems the binary patterns above also match it
!test/harness/gizmo
test/*/*.log
test/*/*.bak
test/*/*_ics.hdf5
test/*/spcool_tables/
test/*/spcool_tables.tgz
test/*/TREECOOL
test/*/ewald_spc_table_*.dat
test/*/glass_*.hdf5
test/*/*.params-usedvalues
test/*/test_*.out
test/*/test_*.err
test/*/__pycache__/
test/*/*.png
test/*/*.pdf
test/*/test_helmholtz
test/*/test_nuclear

# Binary reference/data files (large, should not be in git)
test/*/*.hdf5
*.tgz
*.tar.gz

# EOS table data files (large, downloaded separately)
src/eos/helmholtz/helm_table.dat

# Python build artifacts
*.egg-info/
.pytest_cache/
__pycache__/
*.pyc

# Build directory
build/

# Claude Code per-session state (auto-memory, transcripts, etc.)
.claude/

# Local developer harnesses (benchmark drivers, build-vs-build comparisons, superseded
# setups whose content now lives in a test problem's variants). Kept on disk for the
# developers' own use; not test problems, so not part of the distributed code.
test/benchmark/
test/hernquist_sidm/
test/isodisk_rtsources/
test/fire_gravtree_rt/
test/gravtree/Config_*.sh
test/gravtree/compare_*.py

# Local handoff / agent memory / planning notes. Same rationale as .claude/:
# meaningful only to the immediate working session, not part of the code.
# (The tracked user guide lives in docs/; only this scratch subdir is ignored.)
docs/scratch/

# Stray dev-scratch test notes (out-of-date WIP memos shipped from upstream
# branches; not user-facing docs).
test/biermann_growth/NOTES.md

# Python bytecode caches (regenerated on every pytest invocation, not source).
*.pyo
test/fire_m11i/
test/poisson_starforge/

# AI-assistant / planning scratch — NEVER commit these to the gizmo source
# repo. They are working notes (audit lists, design docs, session state,
# handoffs, memory indexes) that other users cannot parse or use; committing
# them creates clutter, confusion, and security risk.
OPEN_*.md
STATE_*.md
HANDOFF_*.md
MEMORY.md
*_design.md
*_handoff.md
# Session working directories: spikes, gate harnesses, apply/revert probes and their logs.
# Untracked by convention for several sessions, but nothing enforced it -- one `git add -A`
# would have swept them into public history.
patches_*/
_spike_backup_*/
.claude_required_reading.txt
# scratch parameter-file variants used when driving a test by hand
test/*/_*.params
