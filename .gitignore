*.o
/GIZMO
GIZMO_config.h
compile_time_info.cc
/Config.sh

# Test artifacts
test/*/output/
test/*/output_*/
test/*/GIZMO
test/*/*_ics.hdf5
# suites that generate one IC and one params file per problem keep them in subdirectories, which the
# patterns above miss
test/*/ics/
test/*/params/
# per-variant result dumps and archived tolerance-scan points: hundreds of MB of JSON
test/*/results_*.json
test/*/archive/
test/*/spcool_tables/
test/*/spcool_tables.tgz
test/*/TREECOOL
test/*/ewald_spc_table_*.dat
test/*/glass_*.hdf5
test/*/*.params-usedvalues
test/*/test_*.out
test/*/test_*.err
test/*/__pycache__/
test/*/*.png
python_src/gizmo.egg-info/

# Slurm/pytest output from the in-tree test runners, which write to the repo root
/__pycache__/
pytest_wt_slurm-*.out
pytest_wt_slurm-*.err
pytest_results-*.txt
