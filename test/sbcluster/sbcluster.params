% Santa Barbara cluster comparison test (Hopkins 2015)
%
%        HYDRO_MESHLESS_FINITE_MASS
%        BOX_PERIODIC
%        PMGRID=32
%        PM_HIRES_REGION_CLIPPING=1000
%        ADAPTIVE_GRAVSOFT_FORGAS
%
InitCondFile                       sbcluster_ics
OutputDir                          output
TimeBegin                          0.02
TimeMax                            1
ComovingIntegrationOn              1
BoxSize                            1
Omega_Matter                       1
Omega_Lambda                       0
Omega_Baryon                       0.1
HubbleParam                        0.5
UnitLength_in_cm                   9.87417e+25
UnitMass_in_g                      1.80886e+49
UnitVelocity_in_cm_per_s           1.10567e+08
UnitMagneticField_in_gauss         1
MinGasKernelRadiusFractional       1
SofteningGas                       0.0001
Softening_Type1                    0.0005
Softening_Type2                    0
Softening_Type3                    0
Softening_Type4                    0
Softening_Type5                    0
SofteningGasMaxPhys                0.0001
Softening_Type1_MaxPhysLimit       0.0005
Softening_Type2_MaxPhysLimit       0
Softening_Type3_MaxPhysLimit       0
Softening_Type4_MaxPhysLimit       0
Softening_Type5_MaxPhysLimit       0
InitGasTemp                        100
MinGasTemp                         10
BiniX                              0
BiniY                              0
BiniZ                              1e-08
TimeOfFirstSnapshot                0.02
ScaleFac_Between_Snapshots         2
MaxSizeTimestep                    0.05
DesNumNgb                          32
MaxNumNgbDeviation                 0.1
ErrTolIntAccuracy                  0.01
CourantFac                         0.2
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.001
ErrTolTheta                        0.7
TimeBetStatistics                  0.5
ResubmitOn                         0
ResubmitCommand                    none
