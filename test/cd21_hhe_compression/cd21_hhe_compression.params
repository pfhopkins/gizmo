% Phase 17h smoke test: 1D periodic adiabatic compression of H/He fluid via
% the Chabrier-Debras 2021 (CD21, Y=0.275) tabulated EOS, loaded through
% the existing ANEOS dispatch (EOS_ANEOS). The native CD21 (logT, logP)
% ASCII table is converted to SESAME format by
% python_src/eos_tools/cms_to_sesame.py; the converted file
% cd21_y0275.sesame ships next to this params file.
%
% IC built by make_ics.py: 128 particles, uniform rho=1e-2 g/cm^3, T=1000 K,
% sinusoidal velocity perturbation amplitude 1e3 cm/s. CGS code units.
% Sound speed ~3.4e5 cm/s -> sound-crossing time ~3e-5 s; TimeMax=3e-4 s
% (~10 crossings, plenty for smoke).
%
% This is a compile-and-smoke target only. Physics validation
% (Jupiter/Saturn polytrope vs published interior models) is deferred.
%
%        HYDRO_MESHLESS_FINITE_MASS
%        BOX_SPATIAL_DIMENSION=1
%        BOX_PERIODIC
%        SELFGRAVITY_OFF
%        EOS_ANEOS

InitCondFile                       compression_ics
OutputDir                          output
TimeMax                            3.0e-4
BoxSize                            10
TimeBetSnapshot                    1.0e-4
MaxSizeTimestep                    1.0e-7
MinSizeTimestep                    1.0e-10
TimeBetStatistics                  1.0e-4
DesNumNgb                          4
MaxNumNgbDeviation                 1e-6
ErrTolIntAccuracy                  0.0025
CourantFac                         0.05
MaxRMSDisplacementFac              0.125
ResubmitOn                         0
ResubmitCommand                    none
ErrTolTheta                        0.7
ErrTolForceAcc                     0.001

% Code units: CGS direct.
UnitLength_in_cm                   1.0
UnitMass_in_g                      1.0
UnitVelocity_in_cm_per_s           1.0
UnitMagneticField_in_gauss         1.0
GravityConstantInternal            0

% ANEOS table parameters.
AneosNumMaterials                  1
AneosTable0                        cd21_y0275.sesame

InitGasTemp                        1000
MinGasTemp                         10
MinGasHsmlFractional               0
SofteningGas                       0.05
SofteningHalo                      0.05
SofteningDisk                      0.05
SofteningBulge                     0.05
SofteningStars                     0.05
SofteningBndry                     0.05
SofteningGasMaxPhys                0.05
SofteningHaloMaxPhys               0.05
SofteningDiskMaxPhys               0.05
SofteningBulgeMaxPhys              0.05
SofteningStarsMaxPhys              0.05
SofteningBndryMaxPhys              0.05
TimeBegin                          0
ComovingIntegrationOn              0
TimeOfFirstSnapshot                0
SnapFormat                         3
NumFilesPerSnapshot                1
NumFilesWrittenInParallel          1
CpuTimeBetRestartFile              7200
TimeLimitCPU                       100000
ICFormat                           3
TypeOfTimestepCriterion            0
TypeOfOpeningCriterion             1
OutputListOn                       0
OutputListFilename                 output_times.txt
PeriodicBoundariesOn               1
