% Stella x FIRE-3 coupled-mode run parameters (from the hybrid T5 setup) with the isolated-feedback test overrides
% P3 T5/T6 SF-switch box (pc, Msun, km/s)
ICFormat    3
SnapFormat  3
RestartFile                 restart
SnapshotFileBase            snapshot
OutputListOn                0
OutputListFilename          output_times.txt
NumFilesPerSnapshot         1
NumFilesWrittenInParallel   1
CpuTimeBetRestartFile   1e9
ResubmitOn              0
ResubmitCommand         my-scriptfile
MinSizeTimestep         1.0e-15
UnitLength_in_cm            3.09e+18
UnitMass_in_g               1.99e+33
UnitVelocity_in_cm_per_s    1.00e+05
UnitMagneticField_in_gauss  1.00e+00
GravityConstantInternal     0
ComovingIntegrationOn   0
Omega0                  0.
OmegaLambda             0.
OmegaBaryon             0.
HubbleParam             1.
PartAllocFactor     10.0
BufferSize          200
TreeDomainUpdateFrequency   0.005
MinGasTemp      2.73
DesNumNgb               32
MaxHsml                 1.0e10
MinGasKernelRadiusFractional    0
SofteningHalo   0.02
SofteningDisk   0.15
SofteningBulge  0.5
SofteningBndry  3.11e-05
SofteningHaloMaxPhys    0.02
SofteningDiskMaxPhys    0.15
SofteningBulgeMaxPhys   0.5
SofteningBndryMaxPhys   3.11e-05
AGS_DesNumNgb           32
BiniX   1.0e-8
BiniY   1.0e-8
BiniZ   1.0e-8
ConductionCoeff  1.0
ShearViscosityCoeff     1.0
BulkViscosityCoeff      1.0
TurbDiffusionCoefficient 1.0
CritPhysDensity     100.
SfEffPerFreeFall    1.0
InitStellarAge              0.0
WindMomentumLoading         1.0
SNeIIEnergyFrac             1.0
HIIRegion_fLum_Coupled      1.0
PhotonMomentum_Coupled_Fraction  1.0
PhotonMomentum_fUV          0.0
PhotonMomentum_fOPT         0.0
GasReturnFraction           1.0
GasReturnEnergy             1.0
InterstellarRadiationFieldStrength  1.0
SeedSinkMass                 1.0e-3
SeedReservoirMass            0.0
SeedSinkMinRedshift          2.0
SeedSinkMassSigma            0.5
MinFoFMassForNewSeed         10.
TimeBetOnTheFlyFoF           1.01
SinkAccretionFactor          1.0
SinkEddingtonFactor          1e100
SinkNgbFactor                1.0
SinkMaxAccretionRadius       10.0
SinkRadiativeEfficiency      5e-7
SinkFeedbackFactor           1.0
Sink_FluxMomentumFactor      0.0
Sink_accreted_fraction       0.7
Sink_outflow_velocity        100.
Sink_outflow_temperature     1.0e3
Sink_outflow_particlemass    1.0e-2
Sink_outflow_particlemass_MS 1.0e-3
% Stella
FacSfThreshMJ                   1.0
IMFSampleMinMass                0.08
IMFSampleStellarMassCut         0.5
MaxStellarTimestep              10000.0
MaxPISearchRadius               0.05
G0                              1.7
CosmicRayIonRate                3.0e-19
DGRnormalized                   0.01
ShieldingLength                 0.05
InitialMetallicity              0.1
InitCondFile                    box_ics
OutputDir                       output
BoxSize                         0.016
TimeBegin                       0.0
TimeMax                         5.0e-6
TimeBetSnapshot                 1.0e-5
TimeBetStatistics               1.0e-6
TimeOfFirstSnapshot             0
MaxSizeTimestep                 1.0e-7
InitGasTemp                     0
MaxMemSize                      3500
TimeLimitCPU                    20000
SofteningGas                    1.0e-4
SofteningGasMaxPhys             1.0e-4
SofteningStars                  1.0e-4
SofteningStarsMaxPhys           1.0e-4
InitMetallicity                 1.0
TestStarMass                    3.0
TestNumStars                    1
TestStarMass2                   0
TestStarMass3                   0
TestSNTime0                     1.0e-6
TestIaTime                      3.5e-6
TestFUVZero                     1
StellarTablesFile               gizmo/galaxy_sf/stellar_tables/stellar_tables_unified.hdf5
