%---- turbulent_box: 32^3 periodic isothermal box stirred to Mach 10. Units pc - km/s - Msun.
InitCondFile                turbulent_box_ics
OutputDir                   output
ICFormat                    3
SnapFormat                  3
RestartFile                 restart
SnapshotFileBase            snapshot
OutputListOn                0
OutputListFilename          output_times.txt
NumFilesPerSnapshot         1
NumFilesWrittenInParallel   1

TimeOfFirstSnapshot         0
TimeBetSnapshot             1.0
TimeLimitCPU                86400
CpuTimeBetRestartFile       7200

TimeBegin                   0
TimeMax                     20     % 4 t_eddy, t_eddy = TurbDrive_MaxWavelength / TurbDrive_ApproxRMSVturb = 5
MaxSizeTimestep             0.05
MinSizeTimestep             1e-12

UnitLength_in_cm            3.085678e18     % 1 pc
UnitMass_in_g               1.989e33        % 1 Msun
UnitVelocity_in_cm_per_s    1.0e5           % 1 km/s
UnitMagneticField_in_gauss  1.0             % MagneticField in the ICs/snapshots is in gauss (MAGNETIC builds only)
GravityConstantInternal     0

ComovingIntegrationOn       0
BoxSize                     10.0
Omega0                      0
OmegaLambda                 0
OmegaBaryon                 0
HubbleParam                 1

MaxMemSize                  2000
PartAllocFactor             5.0
BufferSize                  100
TreeDomainUpdateFrequency   0.05

InitGasTemp                 0       % from the ICs (overridden by EOS_ENFORCE_ADIABAT)
MinGasTemp                  0

DesNumNgb                   32
MinGasKernelRadiusFractional 0

SofteningGas                1e-3
SofteningHalo               1e-3
SofteningDisk               1e-3
SofteningBulge              1e-3
SofteningStars              1e-3
SofteningBndry              1e-3
SofteningGasMaxPhys         1e-3
SofteningHaloMaxPhys        1e-3
SofteningDiskMaxPhys        1e-3
SofteningBulgeMaxPhys       1e-3
SofteningStarsMaxPhys       1e-3
SofteningBndryMaxPhys       1e-3

%---- Turbulent driving (TURB_DRIVING): solenoidal, parabolic spectrum on 1 <= kL/2pi <= 3, peak at 2
TurbDrive_ApproxRMSVturb            2.0             % target 3D v_rms: Mach 10 at c_s = 0.2 km/s
TurbDrive_MaxWavelength             10.0            % k = 1
TurbDrive_MinWavelength             3.3333333333    % k = 3
TurbDrive_DrivingSpectrum           1               % parabola, zero at kmin and kmax
TurbDrive_SolenoidalFraction        1.0
TurbDrive_CoherenceTime             2.5             % L / (2 v_rms): turnover time at the peak wavelength
TurbDrive_TimeBetweenTurbUpdates    0.025
TurbDrive_RandomNumberSeed          42
