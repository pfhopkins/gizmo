% poisson_box: a periodic 100 pc box of magnetized, cooling gas whose cells sit at
% Poisson-random positions (make_poisson_box_ics.py; no lattice, no glass) -- the least
% regular particle arrangement the neighbour search, kernel-radius iteration, gradient
% and MHD estimators can be handed. Gravity is present in the code path but negligible
% (GravityConstantInternal = 1e-100). A few steps, all cells active.
% Build with this directory's Config.sh. For scaling studies, write other resolutions
% with make_poisson_box_ics.py and point InitCondFile at them.

%----  Relevant files
InitCondFile  poisson_box_50_ics
OutputDir     output

%---- File formats
ICFormat    3
SnapFormat  3

%---- Output parameters
RestartFile                 restart
SnapshotFileBase            snapshot
OutputListOn                0
OutputListFilename          output_times.txt
NumFilesPerSnapshot         1
NumFilesWrittenInParallel   1

%---- Output frequency
TimeOfFirstSnapshot     0.0
TimeBetSnapshot         0.001
TimeBetStatistics       0.001

%---- CPU run-time and checkpointing
TimeLimitCPU            3600
CpuTimeBetRestartFile   3600

%---- Simulation time range -- just a few steps for density evaluation
TimeBegin   0.0
TimeMax     0.002

%---- Timesteps
MaxSizeTimestep         0.001
MinSizeTimestep         1.0e-15

%---- System of units  (pc / Msun / km-s)
UnitLength_in_cm            3.09e+18
UnitMass_in_g               1.99e+33
UnitVelocity_in_cm_per_s    1.00e+05
UnitMagneticField_in_gauss  1.00e+00
GravityConstantInternal     1e-100

%---- Cosmological parameters (non-cosmological run)
ComovingIntegrationOn   0
BoxSize                 100.0
Omega0                  0.0
OmegaLambda             0.0
OmegaBaryon             0.0
HubbleParam             1.0

%---- Domain decomposition
DomainBuild_ActiveFraction   0.005

%---- Initial temperature & floor
InitGasTemp     1e4
MinGasTemp      2.73

%---- Hydro kernel parameters
DesNumNgb               32
MinGasKernelRadiusFractional 0

%---- Gravitational softening (gravity is negligible here: GravityConstantInternal = 1e-100).
%     The gas softening still sets the length scale of the acceleration timestep criterion
%     (dt ~ sqrt(2 ErrTolIntAccuracy eps / |a|)), so it must be of order the cell spacing
%     (~2 pc): a vanishing softening throttles every step to ~1e-7.
SofteningGas    0.5
SofteningHalo   0.020
SofteningDisk   0.150
SofteningBulge  0.500
SofteningStars  0.100
SofteningBndry  0.100
SofteningGasMaxPhys     0.5
SofteningHaloMaxPhys    0.010
SofteningDiskMaxPhys    0.075
SofteningBulgeMaxPhys   0.250
SofteningStarsMaxPhys   0.0005
SofteningBndryMaxPhys   0.0005

%---- MHD: weak uniform seed field
BiniX   1.0e-8
BiniY   1.0e-8
BiniZ   1.0e-8

%---- Initial metallicity (METALS)
InitMetallicity             1.0
InitStellarAge              0.0

%--- Developer-mode parameters (read only when DEVELOPER_MODE is set)
ErrTolTheta                  0.5
ErrTolForceAcc               0.0025
ErrTolIntAccuracy        0.01
CourantFac               0.2
MaxRMSDisplacementFac    0.125
MaxNumNgbDeviation      0.05
DivBcleaningParabolicSigma   1.0
DivBcleaningHyperbolicSigma  1.0
