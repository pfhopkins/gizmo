%-------------------------------------------------------------------------
%  Poisson-random uniform box -- ghost exchange / neighbor list test
%  Compile with: BOX_PERIODIC, MAGNETIC, MHD_B_SET_IN_PARAMS, COOLING, METALS,
%                COOL_METAL_LINES_BY_SPECIES, SINGLE_STAR_STARFORGE_DEFAULTS
%  (matches current Config.sh on gpu_kokkos_ngbtest branch)
%-------------------------------------------------------------------------

%----  Relevant files
InitCondFile  poisson_box_50_ics
OutputDir     output

%---- File formats
ICFormat    3
SnapFormat  3

%---- Output parameters
RestartFile                 restart
SnapshotFileBase            snapshot
OutputListOn                0
OutputListFilename          output_times.txt
NumFilesPerSnapshot         1
NumFilesWrittenInParallel   1

%---- Output frequency
TimeOfFirstSnapshot     0.0
TimeBetSnapshot         0.001
TimeBetStatistics       0.001

%---- CPU run-time and checkpointing
TimeLimitCPU            3600
CpuTimeBetRestartFile   3600
ResubmitOn              0
ResubmitCommand         my-scriptfile

%---- Simulation time range -- just a few steps for density evaluation
TimeBegin   0.0
TimeMax     0.002

%---- Timesteps
MaxSizeTimestep         0.001
MinSizeTimestep         1.0e-15

%---- System of units  (pc / Msun / km-s)
UnitLength_in_cm            3.09e+18
UnitMass_in_g               1.99e+33
UnitVelocity_in_cm_per_s    1.00e+05
UnitMagneticField_in_gauss  1.00e+00
GravityConstantInternal     1e-100

%---- Cosmological parameters (non-cosmological run)
ComovingIntegrationOn   0
BoxSize                 100.0
Omega0                  0.0
OmegaLambda             0.0
OmegaBaryon             0.0
HubbleParam             1.0

%----- Memory allocation

%---- Domain decomposition
TreeDomainUpdateFrequency   0.005

%---- Initial temperature & floor
InitGasTemp     1e4
MinGasTemp      2.73

%---- Hydro kernel parameters
DesNumNgb               32
MinGasHsmlFractional    0

%---- Gravitational softening (GRAVITY_NOT_PERIODIC => tree gravity off for periodic dims)
SofteningGas    1e-10
SofteningHalo   0.020
SofteningDisk   0.150
SofteningBulge  0.500
SofteningStars  0.100
SofteningBndry  0.100
SofteningGasMaxPhys     0.0005
SofteningHaloMaxPhys    0.010
SofteningDiskMaxPhys    0.075
SofteningBulgeMaxPhys   0.250
SofteningStarsMaxPhys   0.0005
SofteningBndryMaxPhys   0.0005
AGS_DesNumNgb           32

%-------------------------------------------------------------------------
%---------- Physics Modules (parameters needed by compiled-in flags) -----
%-------------------------------------------------------------------------

%---- MHD: weak uniform seed field
BiniX   1.0e-8
BiniY   1.0e-8
BiniZ   1.0e-8

%---- Conduction / Viscosity / Turbulent diffusion (coefficients, may not be active)
ConductionCoeff             1.0
ShearViscosityCoeff         1.0
BulkViscosityCoeff          1.0
TurbDiffusionCoefficient    1.0

%---- Cosmic rays
CosmicRayDiffusionCoeff     1.0

%---- Dust (not active but params needed if compiled)
Grain_Internal_Density          1.0
Grain_Size_Min                  1.e-6
Grain_Size_Max                  1.e-4
Grain_Size_Spectrum_Powerlaw    0.5

%---- Star formation (SINGLE_STAR_STARFORGE_DEFAULTS enables GALSF)
%---- Set CritPhysDensity very high so no SF occurs in this uniform low-density box
CritPhysDensity     1.0e+10
SfEffPerFreeFall    1.0

%---- FIRE / stellar feedback parameters (needed by SINGLE_STAR_STARFORGE_DEFAULTS)
InitMetallicity             1.0
InitStellarAge              0.0
WindMomentumLoading         1.0
SNeIIEnergyFrac             1.0
HIIRegion_fLum_Coupled      1.0
PhotonMomentum_Coupled_Fraction  1.0
PhotonMomentum_fUV          0.0
PhotonMomentum_fOPT         0.0
GasReturnFraction           1.0
GasReturnEnergy             1.0
CosmicRay_SNeFraction       0.1
InterstellarRadiationFieldStrength  1.0

%---- Black holes (needed if BH module compiled in via STARFORGE defaults)
SeedBlackHoleMass            0.5
SeedAlphaDiskMass            0.0
SeedBlackHoleMinRedshift     2.0
SeedBlackHoleMassSigma       0.5
MinFoFMassForNewSeed         10.0
TimeBetOnTheFlyFoF           1.01
BlackHoleAccretionFactor     1.0
BlackHoleEddingtonFactor     1e100
BlackHoleNgbFactor           1.0
BlackHoleMaxAccretionRadius  100.0
BlackHoleRadiativeEfficiency 5e-7
BlackHoleFeedbackFactor      1.0
BH_FluxMomentumFactor        0.0
BAL_f_accretion              0.7
BAL_v_outflow                100.0
BAL_internal_temperature     1.0e3
BAL_wind_particle_mass       0.1
BAL_wind_particle_mass_MS    0.01

%---- Grackle (if COOL_GRACKLE compiled)
GrackleDataFile              CloudyData_UVB=HM2012.h5

%---- Turbulent driving (not active, but param reader may need them)
TurbDrive_ApproxRMSVturb            3.21e+00
TurbDrive_MinWavelength             5.00e+00
TurbDrive_MaxWavelength             2.00e+01
TurbDrive_SolenoidalFraction        1
TurbDrive_CoherenceTime             2.51e+00
TurbDrive_DrivingSpectrum           1
TurbDrive_RandomNumberSeed          42
TurbDrive_TimeBetweenTurbUpdates    2.52e-02
TurbDrive_TimeBetTurbSpectrum       2.52e-02

%---- Tabulated cosmology (not active)
DarkEnergyConstantW       -1
TabulatedCosmologyFile    CosmoTbl

%--- Developer-mode parameters
ErrTolTheta                  0.5
ErrTolForceAcc               0.0025
ErrTolIntAccuracy        0.01
CourantFac               0.2
MaxRMSDisplacementFac    0.125
MaxNumNgbDeviation      0.05
AGS_MaxNumNgbDeviation  0.10
DivBcleaningParabolicSigma   1.0
DivBcleaningHyperbolicSigma  1.0
