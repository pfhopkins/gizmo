% Isolated disk galaxy — mechanical feedback plus explicit M1 radiation transport (Config_rt.sh).
% Pre-existing star particles (Type 4) are older than 5 Myr, so SNe fire and the stars
% inject radiation in the NUV, optical/NIR, IR, photoelectric and photoionizing bands
% from step 1. The reduced speed of light (RT_SPEEDOFLIGHT_REDUCTION=0.001) is chosen so
% the field propagates within a few steps; it is not a converged RT setup.
InitCondFile                       isodisk_mechfb_ics
OutputDir                          output_rt
TimeMax                            0.03
BoxSize                            200
TimeBetSnapshot                    0.01
MaxSizeTimestep                    0.005
DesNumNgb                          32
MaxNumNgbDeviation                 0.1
UnitLength_in_cm                   3.085678e+21
UnitMass_in_g                      1.989e+43
UnitVelocity_in_cm_per_s           100000
SofteningGas                       0.001
Softening_Type1                    0.05
Softening_Type2                    0.1
Softening_Type3                    0.1
Softening_Type4                    0.001
Softening_Type5                    0.005
SofteningGasMaxPhys                0.001
Softening_Type1_MaxPhysLimit       0.05
Softening_Type2_MaxPhysLimit       0.1
Softening_Type3_MaxPhysLimit       0.1
Softening_Type4_MaxPhysLimit       0.001
Softening_Type5_MaxPhysLimit       0.005
MinGasTemp                         10
InitGasTemp                        1e4
CritPhysDensity                    10.
SfEffPerFreeFall                   1.0
InitMetallicity                    0.1
InitStellarAge                     0.001
MinSizeTimestep                    1e-15
ErrTolIntAccuracy                  0.01
CourantFac                         0.2
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.001
ErrTolTheta                        0.7
TimeBetStatistics                  0.5
ResubmitOn                         0
ResubmitCommand                    none
