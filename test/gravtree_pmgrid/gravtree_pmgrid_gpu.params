% PMGRID+BOX_PERIODIC GPU gravity walk validation.
% Uses gmc_cooling ICs (BoxSize=100, 24754 gas particles filling full box).
% SofteningGas=0.1 (reasonable: PMGRID=64 cell~1.56; avoids tiny-dt from 1e-10 softening).
% No COOLING/METALS — clean gravity+hydro only.
%
InitCondFile                       ../gmc_cooling/gmc_cooling_ics
OutputDir                          output_gpu
PartAllocFactor                    10
TimeMax                            0.05
TimeBetSnapshot                    0.025
MaxSizeTimestep                    0.001
DesNumNgb                          40
MaxNumNgbDeviation                 0.1
MaxMemSize                         5000
GravityConstantInternal            1
BoxSize                            100.0
MaxHsml                            2000
SofteningGas                       0.1
SofteningHalo                      0.07
Softening_Type2                    0.003
Softening_Type3                    0.003
Softening_Type4                    0.003
Softening_Type5                    0.003
CourantFac                         0.1
ResubmitOn                         0
ResubmitCommand                    none
ErrTolTheta                        0.7
ErrTolForceAcc                     0.001
TimeBetStatistics                  0.5
ErrTolIntAccuracy                  0.01
MaxRMSDisplacementFac              0.1
TreeRebuild_ActiveFraction         0.005
