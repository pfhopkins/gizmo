% star_direct_siblings: four stars at rest, G = 1, softening far below every separation.
% Started as a snapshot restart (flag 2) so the child numbers and generations of the IC are kept.
InitCondFile                       star_direct_siblings_ics
OutputDir                          output
TimeMax                            1e-3
BoxSize                            100
TimeBetSnapshot                    1e-3
TimeOfFirstSnapshot                0
TimeBegin                          0
TimeBetStatistics                  1e-3
MaxSizeTimestep                    2.5e-4
MinSizeTimestep                    1e-12
ErrTolIntAccuracy                  0.005
ErrTolTheta                        0.01
ErrTolForceAcc                     0.0025
CourantFac                         0.4
MaxRMSDisplacementFac              0.125
TreeDomainUpdateFrequency          0.1
DesNumNgb                          32
MaxNumNgbDeviation                 1
MaxMemSize                         2000
PartAllocFactor                    2.5
BufferSize                         100
ResubmitOn                         0
ResubmitCommand                    none
UnitLength_in_cm                   1
UnitMass_in_g                      1
UnitVelocity_in_cm_per_s           1
GravityConstantInternal            1
Softening_Type0                    1e-4
Softening_Type1                    1e-4
Softening_Type2                    1e-4
Softening_Type3                    1e-4
Softening_Type4                    1e-4
Softening_Type5                    1e-4
Softening_Type0_MaxPhysLimit       1e-4
Softening_Type1_MaxPhysLimit       1e-4
Softening_Type2_MaxPhysLimit       1e-4
Softening_Type3_MaxPhysLimit       1e-4
Softening_Type4_MaxPhysLimit       1e-4
Softening_Type5_MaxPhysLimit       1e-4
AGS_DesNumNgb                      32
AGS_MaxNumNgbDeviation             1
