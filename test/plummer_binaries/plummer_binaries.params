% Plummer cluster of equal-mass circular binaries (Type 5 stars).
% Units: pc - km/s - Msun, so G = 4.302e-3 in code units.
% N=256 binaries, M_star=1 Msun, M_cluster=512 Msun, a_cluster=1 pc.
% Half-mass crossing time t_cross ~ 3.24 code time units (~ 3.17 Myr).
% TimeMax = 32.4 covers ~10 cluster crossings; binary period (1000 AU, 2 Msun)
% is ~0.023 code units, so ~1400 binary orbits over the run.
% TimeBetSnapshot = t_cross / 10 -> 100 snapshots over the test.
% Plummer-equivalent softening = 6.43 AU = 3.117e-5 pc (= 18 AU / 2.8), so the
% actual cubic-spline kernel radius is the desired 18 AU.
%
InitCondFile                       plummer_binaries_ics
OutputDir                          output
TimeMax                            32.4
BoxSize                            300
TimeBetSnapshot                    0.324
TimeOfFirstSnapshot                0
TimeBegin                          0
TimeBetStatistics                  0.4
MaxSizeTimestep                    0.05
MinSizeTimestep                    1e-12
ErrTolIntAccuracy                  0.005
ErrTolTheta                        0.5
ErrTolForceAcc                     0.0025
CourantFac                         0.4
MaxRMSDisplacementFac              0.125
% With only 512 particles and KETJU forcing all chain members onto a common
% high timebin, the active-particle count per step is ~512, so the default
% 0.1*TotNumPart trigger (= 51 updates) fires every step and domain decomp
% costs ~80% of wall time. Bumping to 10 (= 5120 updates) decomps every ~10
% steps and reduces domain overhead to <10% of total.
TreeDomainUpdateFrequency          10
DesNumNgb                          32
MaxNumNgbDeviation                 1
MaxMemSize                         2000
PartAllocFactor                    2.5
BufferSize                         100
ResubmitOn                         0
ResubmitCommand                    none
UnitLength_in_cm                   3.085678e+18
UnitMass_in_g                      1.989e+33
UnitVelocity_in_cm_per_s           100000
Softening_Type0                    3.117e-5
Softening_Type1                    3.117e-5
Softening_Type2                    3.117e-5
Softening_Type3                    3.117e-5
Softening_Type4                    3.117e-5
Softening_Type5                    3.117e-5
Softening_Type0_MaxPhysLimit       3.117e-5
Softening_Type1_MaxPhysLimit       3.117e-5
Softening_Type2_MaxPhysLimit       3.117e-5
Softening_Type3_MaxPhysLimit       3.117e-5
Softening_Type4_MaxPhysLimit       3.117e-5
Softening_Type5_MaxPhysLimit       3.117e-5
AGS_DesNumNgb                      32
AGS_MaxNumNgbDeviation             1
CritPhysDensity                    1e13
CpuTimeBetRestartFile              30
% Cap sink accretion-search at the softening kernel radius (18 AU = 8.726e-5 pc).
% With no gas in this test the default 5 pc search radius wastes huge amounts of
% tree-walking; shrinking it to the softening scale eliminates that overhead.
SinkMaxAccretionRadius             8.726e-5
% KETJU regularized integrator params (ignored unless Config.sh has
% KETJU_REGULARIZATION). KetjuMinStarMass=0.5 enables chain regularization on
% the 1-Msun binary stars; KetjuUseStarStarSoftening=0 turns off softening
% within chains so binaries are integrated by MSTAR unsoftened.
% KetjuRegionRadius=0.005 pc (~ 1031 AU) is just above the 1000-AU binary
% separation so each binary's partner is captured into one chain. The merge
% radius (2 * KetjuRegionRadius = ~ 0.01 pc) is well below the typical
% inter-binary spacing (~0.15 pc) so neighbouring binaries don't merge.
KetjuRegionRadius                  0.005
KetjuMinStarMass                   0.5
KetjuMinBHMass                     0
% NOTE: an earlier run with KetjuUseStarStarSoftening=0 produced unphysical
% velocity blow-up (single stars accelerated to ~400 km/s, >>> escape velocity)
% within 4 code time units, almost certainly from unsoftened MSTAR handling of
% transient close encounters between stars from different binaries. Keep =1 so
% MSTAR uses the same star-star softening as the host tree force.
KetjuUseStarStarSoftening          1
