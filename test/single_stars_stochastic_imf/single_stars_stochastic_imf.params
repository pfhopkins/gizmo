% stochastic IMF: the lattice of single_stars_sf_criterion (16^3 cells of 1 Msun, every cell above CritPhysDensity), efficiency 1e3 so
% the cells form in the first steps; MassPerStarIMF 4: one carrier in four holds a drawn star
InitCondFile                       single_stars_stochastic_imf_ics
OutputDir                          output
TimeMax                            1e-5
BoxSize                            2.56
TimeBetSnapshot                    1e-5
DesNumNgb                          32
MaxNumNgbDeviation                 0.1
UnitLength_in_cm                   3.085678e+18
UnitMass_in_g                      1.989e+33
UnitVelocity_in_cm_per_s           100000
MinGasTemp                         10
ErrTolIntAccuracy                  0.002
CourantFac                         0.05
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.0015
TimeBetStatistics                  1e-5
MaxSizeTimestep                    1e-6
ResubmitOn                         0
ResubmitCommand                    none
ErrTolTheta                        0.7
DomainBuild_ActiveFraction         0.5
CritPhysDensity                    10
SfEffPerFreeFall                   1e3
InitMetallicity                    1.0
StellarTablesFile                  SET_BY_TEST
MaxStellarTimestep                 100.0
MinMassIMF                         8.0
MaxMassIMF                         120.0
MassPerStarIMF                     4.0
