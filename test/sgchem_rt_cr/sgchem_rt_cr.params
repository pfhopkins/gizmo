InitCondFile                sgchem_rt_cr_ics
OutputDir                   output
ICFormat                    3
SnapFormat                  3
TimeBegin                   0.0
TimeMax                     4.0e-5
TimeOfFirstSnapshot         0.
TimeBetSnapshot             2.0e-5
MaxSizeTimestep             1.0e-5
MinSizeTimestep             1.0e-15
UnitLength_in_cm            3.086e18    % pc
UnitMass_in_g               1.989e33    % Msun
UnitVelocity_in_cm_per_s    1.0e5       % km/s
ComovingIntegrationOn       0
BoxSize                     10.0
Omega0                      0.
OmegaLambda                 0.
OmegaBaryon                 0.
HubbleParam                 1.
InitGasTemp                 0           % from the IC
MinGasTemp                  2.73
InitMetallicity             1.0         % solar, GIZMO's element pattern (fresh starts do not read IC metals)
DesNumNgb                   32
SofteningGas                0.1
SofteningHalo               0.1
SofteningDisk               0.1
SofteningBulge              0.1
SofteningStars              0.1
SofteningBndry              0.1
SGChemTablesPath            sgchem_tables          % overridden by the test
StellarTablesFile           stellar_tables         % overridden by the test
TreeColShieldingLength      1e-6
CritPhysDensity             1e30
SfEffPerFreeFall            0.01
SGChemCosmicRayIonRate 3.0e-17
SGChemDustToGasRatio        1.0         % Milky Way at solar metallicity
SGChemDeuteriumAbundance    2.6e-5      % D/H
SGChemG0                    0           % no radiation field (test_sgchem_habing_field sets one)
SGChemG0_LW                 0
SGChemBackgroundG0          0
BiniX 0
BiniY 0
BiniZ 2.0e-6
CosmicRay_SNeFraction 0.1
CosmicRayDiffusionCoeff 690
CosmicRayInitialAmbient_eVcm3 1.0
InitRadiationTemp 10
InitRadiationTemp 10
UnitMagneticField_in_gauss 1.0
