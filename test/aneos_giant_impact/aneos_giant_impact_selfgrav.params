% ANEOS giant-impact HSE validation gate (SELFGRAVITY=ON variant).
% Earth-mass differentiated body (forsterite mantle 68% + iron core 32%) built
% with the Phase 17h HSE IC builder against the Stewart S19/S20 tables.
% t_dyn(surface) ~ 740 s; TimeMax = 8000 s ~ 11 t_dyn.
%
%        HYDRO_MESHLESS_FINITE_MASS
%        EOS_ANEOS
%        ADAPTIVE_GRAVSOFT_FORGAS
% (no SELFGRAVITY_OFF -> self-gravity is ON)

InitCondFile                       aneos_giant_impact_ics
OutputDir                          output_selfgrav
TimeBegin                          0.0
TimeMax                            8000.0
TimeBetSnapshot                    1000.0
MaxSizeTimestep                    5.0
MinSizeTimestep                    1.0e-3
TimeBetStatistics                  100.0

BoxSize                            6.0e9
DesNumNgb                          32
MaxNumNgbDeviation                 0.1

CourantFac                         0.3
ErrTolIntAccuracy                  0.01
MaxRMSDisplacementFac              0.1

ErrTolTheta                        0.7
ErrTolForceAcc                     0.001

UnitLength_in_cm                   1.0
UnitMass_in_g                      1.0
UnitVelocity_in_cm_per_s           1.0

SofteningGas                       1.0e7
SofteningHalo                      1.0e7
SofteningDisk                      1.0e7
SofteningBulge                     1.0e7
SofteningStars                     1.0e7
SofteningBndry                     1.0e7


ResubmitOn                         0
ResubmitCommand                    none

AneosNumMaterials                  2
AneosTable0                        forsterite.sesame
AneosTable1                        iron.sesame
