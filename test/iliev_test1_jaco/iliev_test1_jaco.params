%---- Iliev et al. (2006) test 1 at n_H = 100 cm^-3: R_S = 2.13 pc, t_rec = 7.73e-4 (case A, 1e4 K)
InitCondFile  iliev_test1_jaco_ics
OutputDir     output
ICFormat      3
SnapFormat    3
RestartFile                 restart
SnapshotFileBase            snapshot
OutputListOn                0
OutputListFilename          output_times.txt
NumFilesPerSnapshot         1
NumFilesWrittenInParallel   1

%---- Output frequency: every 0.25 t_rec, to 4.25 t_rec
TimeOfFirstSnapshot     0.0
TimeBetSnapshot         1.9325538e-04
TimeBetStatistics       1.9325538e-04
TimeBegin   0.0
TimeMax     3.2853415e-03
MaxSizeTimestep         1.5e-06
MinSizeTimestep         1.0e-15

TimeLimitCPU            172800
CpuTimeBetRestartFile   7200
ResubmitOn              0
ResubmitCommand         my-scriptfile

%---- System of units: pc, Msun, km/s
UnitLength_in_cm            3.09e+18
UnitMass_in_g               1.989e+33
UnitVelocity_in_cm_per_s    1.00e+05
UnitMagneticField_in_gauss  1.00e+00
GravityConstantInternal     0

ComovingIntegrationOn   0
BoxSize                 6.0
Omega0                  0.
OmegaLambda             0.
OmegaBaryon             0.
HubbleParam             1.

MaxMemSize          5000
PartAllocFactor     5.0
BufferSize          500
TreeDomainUpdateFrequency   0.005

%---- Gas held at 1e4 K by the test's fixed-temperature chemistry
InitGasTemp     1e4
MinGasTemp      10

%---- Softenings: no gravity, but the source particle's timestep criterion reads its softening
SofteningGas    1e-10
SofteningHalo   0.020
SofteningDisk   0.150
SofteningBulge  0.500
SofteningStars  0.01
SofteningBndry  0.01
SofteningGasMaxPhys     0.0005
SofteningHaloMaxPhys    0.010
SofteningDiskMaxPhys    0.075
SofteningBulgeMaxPhys   0.250
SofteningStarsMaxPhys   0.0005
SofteningBndryMaxPhys   0.0005

DesNumNgb               32
MaxKernelRadius         1.0e10
MinGasKernelRadiusFractional    0

ErrTolTheta                  0.5
ErrTolForceAcc               0.0025
ErrTolIntAccuracy        0.01
CourantFac               0.2
MaxRMSDisplacementFac    0.125
MaxNumNgbDeviation      0.05

%---- Ionizing source of the idealized test problems: 1e5 K blackbody (RT_ILIEV_TEST1 sets 5e48 photons/s)
IonizingLuminosityPerSolarMass_cgs  0
star_Teff                           1.0e5
