% cbe_two_stream — 1D counter-streaming CBE test (no gravity, no hydro, no gas).
% Type=1 particles carry a 2-basis (+1/-1) internal velocity distribution via
% the IC VlasovMoments dataset. Config: BOX_SPATIAL_DIMENSION=1, BOX_PERIODIC,
% SELFGRAVITY_OFF, CBE_INTEGRATOR=2 (+OUTPUT_MOREINFO), STOP_WHEN_BELOW_MINTIMESTEP.

InitCondFile                       cbe_two_stream_ics
OutputDir                          output

TimeBegin                          0.0
TimeMax                            0.2          % ~1/5 of a box-crossing at v_stream=1
TimeBetSnapshot                    0.025        % ~8 snapshots
TimeBetStatistics                  0.025

BoxSize                            1.0

% Neighbour targets — CBE rides the AGS kernel/volume solve on Type=1.
% 1D: keep the kernel local (cf. soundwave DesNumNgb=4).
AGS_DesNumNgb                      8
AGS_MaxNumNgbDeviation             0.5
DesNumNgb                          8
MaxNumNgbDeviation                 0.5

% Softening — AGS_KernelRadius is adaptive; these bound it (unused for force
% since SELFGRAVITY_OFF, but parsed).
Softening_Type0                    0.01
Softening_Type1                    0.01
Softening_Type2                    0.01
Softening_Type3                    0.01
Softening_Type4                    0.01
Softening_Type5                    0.01
Softening_Type0_MaxPhysLimit       0.1
Softening_Type1_MaxPhysLimit       0.1
Softening_Type2_MaxPhysLimit       0.1
Softening_Type3_MaxPhysLimit       0.1
Softening_Type4_MaxPhysLimit       0.1
Softening_Type5_MaxPhysLimit       0.1

% Code units (arbitrary; G unused with SELFGRAVITY_OFF)
UnitLength_in_cm                   1.0
UnitMass_in_g                      1.0
UnitVelocity_in_cm_per_s           1.0

% Timestepping
MaxSizeTimestep                    0.01
MinSizeTimestep                    1e-6
ErrTolIntAccuracy                  0.01
CourantFac                         0.2
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.001
ErrTolTheta                        0.7

% Misc
ResubmitOn                         0
ResubmitCommand                    none
