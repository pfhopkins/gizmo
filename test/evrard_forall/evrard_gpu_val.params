% AGS GPU walk Tier 1c validation: evrard with ADAPTIVE_GRAVSOFT_FORALL=1
% Exercises SYMMETRIZE_FORCE_BY_AVERAGING branch (auto-defined by FORALL).
% Build twice (+/- GIZMO_GPU_GRAVTREE), compare snapshots.
% TreeRebuild_ActiveFraction=2.0 is REQUIRED so TakeLevel=-1 and GPU walk fires.
InitCondFile                       evrard_ics
OutputDir                          output_gpu_val
PartAllocFactor                    20
TimeMax                            0.05
TimeBetSnapshot                    0.025
MaxSizeTimestep                    0.001
DesNumNgb                          40
MaxNumNgbDeviation                 0.1
AGS_DesNumNgb                      47
AGS_MaxNumNgbDeviation             4
MaxMemSize                         3000
GravityConstantInternal            1
MaxHsml                            0.3
MaxKernelRadius                    0.3
SofteningGas                       0.01
SofteningHalo                      0.07
Softening_Type2                    0.003
Softening_Type3                    0.003
Softening_Type4                    0.003
Softening_Type5                    0.003
CourantFac                         0.1
ResubmitOn                         0
ResubmitCommand                    none
ErrTolTheta                        0.7
ErrTolForceAcc                     0.001
TimeBetStatistics                  0.5
ErrTolIntAccuracy                  0.01
MaxRMSDisplacementFac              0.1
TreeRebuild_ActiveFraction         2.0
