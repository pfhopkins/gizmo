% Force check for GRAVITY_PERIODIC_XY: x/y (shear-)periodic, z-open self-gravity on a 1 x 1 x 4 box (mid-plane z = 2).
% One heavy particle + a random cloud as sources, massless tracers as probes. G = 1. Runs a single short step.
InitCondFile                       slab_ewald_ics
OutputDir                          output
BoxSize                            1
TimeBegin                          0.37        % with BOX_SHEARING (Omega = q = 1, L = 1) the shear offset is s = 0.37
TimeMax                            0.370001
TimeBetSnapshot                    1
TimeOfFirstSnapshot                0.37
TimeBetStatistics                  1
MaxSizeTimestep                    1e-6
MinSizeTimestep                    0
ErrTolIntAccuracy                  0.02
ErrTolTheta                        0.5
ErrTolForceAcc                     0.0025
CourantFac                         0.4
MaxRMSDisplacementFac              0.125
TreeDomainUpdateFrequency          0.1
DesNumNgb                          32
MaxNumNgbDeviation                 1
MaxMemSize                         2000
PartAllocFactor                    2.5
BufferSize                         100
ResubmitOn                         0
ResubmitCommand                    none
UnitLength_in_cm                   1
UnitMass_in_g                      1
UnitVelocity_in_cm_per_s           1
GravityConstantInternal            1
Softening_Type0                    1e-4
Softening_Type1                    1e-4
Softening_Type2                    1e-4
Softening_Type3                    1e-4
Softening_Type4                    1e-4
Softening_Type5                    1e-4
Softening_Type0_MaxPhysLimit       1e-4
Softening_Type1_MaxPhysLimit       1e-4
Softening_Type2_MaxPhysLimit       1e-4
Softening_Type3_MaxPhysLimit       1e-4
Softening_Type4_MaxPhysLimit       1e-4
Softening_Type5_MaxPhysLimit       1e-4
AGS_DesNumNgb                      32
AGS_MaxNumNgbDeviation             1
