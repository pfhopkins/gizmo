% 3D shearing box (BOX_SHEARING=3), coordinates (0,1,2) = (r,phi,z), Omega = 1, L = 1, c_s = 1.
% The test overrides InitCondFile, OutputDir, TimeMax and TimeBetSnapshot for each case.
InitCondFile                       shearing_box_ics
OutputDir                          output
TimeMax                            18.85
BoxSize                            1
TimeBetSnapshot                    0.5
DesNumNgb                          32
MaxNumNgbDeviation                 0.1
MaxMemSize                         1000
GravityConstantInternal            1
ErrTolIntAccuracy                  0.01
CourantFac                         0.2
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.001
TimeBetStatistics                  0.5
MaxSizeTimestep                    0.05
ErrTolTheta                        0.7
ResubmitOn                         0
ResubmitCommand                    none
SofteningGas                       0.01
SofteningGasMaxPhys                0.01
Softening_Type1                    0.01
Softening_Type1_MaxPhysLimit       0.01
Softening_Type2                    0.01
Softening_Type2_MaxPhysLimit       0.01
Softening_Type3                    0.01
Softening_Type3_MaxPhysLimit       0.01
Softening_Type4                    0.01
Softening_Type4_MaxPhysLimit       0.01
Softening_Type5                    0.01
Softening_Type5_MaxPhysLimit       0.01
