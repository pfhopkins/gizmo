% hernquist_dmfuzzy — small DM-only Hernquist halo run as fuzzy dark matter.
% Smoke-test for the dm_fuzzy DMGrad runner-template port (DMGradSpec).
% Reuses the hernquist_sidm IC (Type=1 DM, ~1000 particles); the wavefunction
% is seeded at startup by do_dm_fuzzy_initialization.
%
% Required Config.sh flags: BOX_SPATIAL_DIMENSION=3,
%                           ADAPTIVE_GRAVSOFT_FORALL=2, DM_FUZZY=1.
% Isolated halo — open (non-periodic) domain: no BOX_PERIODIC, no BoxSize.
%
% Units: kpc / 1e10 Msun / km/s (isodisk convention).

InitCondFile                       hernquist_sidm_ics
OutputDir                          output

TimeBegin                          0.0
TimeMax                            0.004       % 2 coarse steps at MaxSizeTimestep=0.002
TimeBetSnapshot                    0.002       % one snapshot per coarse step
TimeBetStatistics                  0.002

% Softening — AGS_KernelRadius is adaptive; these are the min/max bounds
Softening_Type0                    0
Softening_Type1                    0.01
Softening_Type2                    0.01
Softening_Type3                    0.01
Softening_Type4                    0.01
Softening_Type5                    0
Softening_Type0_MaxPhysLimit       0
Softening_Type1_MaxPhysLimit       0.5
Softening_Type2_MaxPhysLimit       0.5
Softening_Type3_MaxPhysLimit       0.5
Softening_Type4_MaxPhysLimit       0.5
Softening_Type5_MaxPhysLimit       0

% Neighbour target for the AGS density / force loops
AGS_DesNumNgb                      32
AGS_MaxNumNgbDeviation             1.0
% (DesNumNgb is a hydro-side knob — set anyway for the parameter parser)
DesNumNgb                          32
MaxNumNgbDeviation                 0.1

% Code units: kpc / 1e10 Msun / km/s
UnitLength_in_cm                   3.085678e+21
UnitMass_in_g                      1.989e+43
UnitVelocity_in_cm_per_s           100000
MinGasTemp                         10
InitGasTemp                        1e4

% Timestepping
MaxSizeTimestep                    0.002
MinSizeTimestep                    1e-6
ErrTolIntAccuracy                  0.01
CourantFac                         0.2
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.001
ErrTolTheta                        0.7

% Fuzzy dark matter: particle mass in eV. TEMPORARY KLUDGE — set to 1e-18
% (not 1e-22, the canonical ultralight scale) purely to keep this uncalibrated
% hernquist_sidm IC from crashing on a fuzzy-DM SPE timestep runaway before the
% DMGrad code paths are exercised. NOT a calibrated value for this IC.
FuzzyDM_Mass_in_eV                 1e-18

% Misc
ResubmitOn                         0
ResubmitCommand                    none
