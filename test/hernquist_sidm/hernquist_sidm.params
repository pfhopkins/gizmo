% hernquist_sidm — small DM-only Hernquist halo with DM_SIDM scatter.
% Used to validate the B2 AGSForce GPU port (ags_force_evaluate_gpu)
% against the CPU tree-walk. Resolution is deliberately minimal
% (~1000 Type=1 DM particles) for quick turnaround.
%
% Required Config.sh flags: BOX_PERIODIC, BOX_SPATIAL_DIMENSION=3,
%                           ADAPTIVE_GRAVSOFT_FORALL=2, DM_SIDM=2.
%
% Units: kpc / 1e10 Msun / km/s (isodisk convention).

InitCondFile                       hernquist_sidm_ics
OutputDir                          output

TimeBegin                          0.0
TimeMax                            0.004       % 2 coarse steps at MaxSizeTimestep=0.002
TimeBetSnapshot                    0.002       % one snapshot per coarse step
TimeBetStatistics                  0.002

% Softening — AGS_KernelRadius is adaptive; these are the min/max bounds
Softening_Type0                    0
Softening_Type1                    0.01
Softening_Type2                    0.01
Softening_Type3                    0.01
Softening_Type4                    0.01
Softening_Type5                    0
Softening_Type0_MaxPhysLimit       0
Softening_Type1_MaxPhysLimit       0.5
Softening_Type2_MaxPhysLimit       0.5
Softening_Type3_MaxPhysLimit       0.5
Softening_Type4_MaxPhysLimit       0.5
Softening_Type5_MaxPhysLimit       0

% Neighbour target for the AGS density / force loops
AGS_DesNumNgb                      32
AGS_MaxNumNgbDeviation             1.0
% (DesNumNgb is a hydro-side knob — set anyway for the parameter parser)
DesNumNgb                          32
MaxNumNgbDeviation                 0.1

% Code units: kpc / 1e10 Msun / km/s
UnitLength_in_cm                   3.085678e+21
UnitMass_in_g                      1.989e+43
UnitVelocity_in_cm_per_s           100000
MinGasTemp                         10
InitGasTemp                        1e4

% Timestepping
MaxSizeTimestep                    0.002
MinSizeTimestep                    1e-6
ErrTolIntAccuracy                  0.01
CourantFac                         0.2
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.001
ErrTolTheta                        0.7

% DM_SIDM params — cross section tuned so a non-trivial number of scatters
% happen within the first few timesteps at this resolution. Units: cm^2/g.
% sigma=1 is physically plausible but still high enough to force many
% scatters at this density and resolution (sigma=1000 was so extreme it
% blew up velocities in the first step — reduced to 1 to keep the run sane).
DM_InteractionCrossSection         1.0
DM_DissipationFactor               0.0
DM_KickPerCollision                0.0
DM_InteractionVelocityScale        0.0

% Misc
MaxMemSize                         2000
ResubmitOn                         0
ResubmitCommand                    none
