%---- turbsphere: uniform sphere (R = 5 pc) in a 50 pc periodic box, stirred to Mach 10 inside 2R. Units pc - km/s - Msun.
InitCondFile                turbsphere_ics
OutputDir                   output
ICFormat                    3
SnapFormat                  3
RestartFile                 restart
SnapshotFileBase            snapshot
OutputListOn                0
OutputListFilename          output_times.txt
NumFilesPerSnapshot         1
NumFilesWrittenInParallel   1

TimeOfFirstSnapshot         0
TimeBetSnapshot             1.0
TimeLimitCPU                86400
CpuTimeBetRestartFile       7200

TimeBegin                   0
TimeMax                     20     % 4 t_cross, t_cross = 2R / TurbDrive_ApproxRMSVturb = 5
MaxSizeTimestep             0.05
MinSizeTimestep             1e-12

UnitLength_in_cm            3.085678e18     % 1 pc
UnitMass_in_g               1.989e33        % 1 Msun
UnitVelocity_in_cm_per_s    1.0e5           % 1 km/s
UnitMagneticField_in_gauss  1.0             % MagneticField in the ICs/snapshots is in gauss (MAGNETIC builds only)
GravityConstantInternal     0

ComovingIntegrationOn       0
BoxSize                     50.0            % 10 R, as GravAccel_GMCTurbInit assumes
Omega0                      0
OmegaLambda                 0
OmegaBaryon                 0
HubbleParam                 1

MaxMemSize                  2000
PartAllocFactor             5.0
BufferSize                  100
TreeDomainUpdateFrequency   0.05

InitGasTemp                 0       % from the ICs (overridden by EOS_ENFORCE_ADIABAT)
MinGasTemp                  0

DesNumNgb                   32
MinGasKernelRadiusFractional 0

SofteningGas                1e-3
SofteningHalo               1e-3
SofteningDisk               1e-3
SofteningBulge              1e-3
SofteningStars              1e-3
SofteningBndry              1e-3
SofteningGasMaxPhys         1e-3
SofteningHaloMaxPhys        1e-3
SofteningDiskMaxPhys        1e-3
SofteningBulgeMaxPhys       1e-3
SofteningStarsMaxPhys       1e-3
SofteningBndryMaxPhys       1e-3

%---- Turbulent driving (TURB_DRIVING): solenoidal, parabolic spectrum on wavelengths 2R/3 - 2R, peak at R
TurbDrive_ApproxRMSVturb            2.0             % target 3D v_rms within 2R: Mach 10 at c_s = 0.2 km/s
TurbDrive_MaxWavelength             5.0             % R: the Lane et al. (2022) band. Modes up to 2R torque the whole cloud and spin it up
TurbDrive_MinWavelength             1.25            % R/4
TurbDrive_DrivingSpectrum           1               % parabola, zero at kmin and kmax
TurbDrive_SolenoidalFraction        1.0
TurbDrive_CoherenceTime             2.5             % R / v_rms = t_cross/2, as MakeCloud
TurbDrive_TimeBetweenTurbUpdates    0.5             % t_cross/10, as STARFORGE stirring runs use with the lazy force
TurbDrive_RandomNumberSeed          42
TurbDrive_PID_Kp                    1.0             % the default 2 alternates update to update with this band and cadence
