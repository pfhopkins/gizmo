% cbe_density_wave — 1D density-modulated counter-streaming CBE test.
% Same Config family as cbe_two_stream; positions inverse-CDF sampled from
% rho(x)=1+eps cos(2 pi x/L). No gravity, no hydro, no gas.

InitCondFile                       cbe_density_wave_ics
OutputDir                          output

TimeBegin                          0.0
TimeMax                            0.15
TimeBetSnapshot                    0.025
TimeBetStatistics                  0.025

BoxSize                            1.0

AGS_DesNumNgb                      4
AGS_MaxNumNgbDeviation             0.5
DesNumNgb                          4
MaxNumNgbDeviation                 0.5

Softening_Type0                    0.01
Softening_Type1                    0.01
Softening_Type2                    0.01
Softening_Type3                    0.01
Softening_Type4                    0.01
Softening_Type5                    0.01
Softening_Type0_MaxPhysLimit       0.1
Softening_Type1_MaxPhysLimit       0.1
Softening_Type2_MaxPhysLimit       0.1
Softening_Type3_MaxPhysLimit       0.1
Softening_Type4_MaxPhysLimit       0.1
Softening_Type5_MaxPhysLimit       0.1

UnitLength_in_cm                   1.0
UnitMass_in_g                      1.0
UnitVelocity_in_cm_per_s           1.0

MaxSizeTimestep                    0.01
MinSizeTimestep                    1e-6
ErrTolIntAccuracy                  0.01
CourantFac                         0.2
MaxRMSDisplacementFac              0.1
ErrTolForceAcc                     0.001
ErrTolTheta                        0.7

MaxMemSize                         1000
ResubmitOn                         0
ResubmitCommand                    none
