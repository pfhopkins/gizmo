% IC written by make_turb_diff_metals_ics.py and read as a snapshot restart (RestartFlag 2),
% so its per-cell metallicities are kept rather than reset at start-up
InitCondFile    turb_diff_metals_ics
OutputDir       output
ICFormat        3
SnapFormat      3
RestartFile                 restart
SnapshotFileBase            snapshot
OutputListOn                0
OutputListFilename          output_times.txt
NumFilesPerSnapshot         1
NumFilesWrittenInParallel   1
TimeOfFirstSnapshot     0.0
TimeBetSnapshot         0.005
TimeBetStatistics       0.05
TimeLimitCPU            172800
CpuTimeBetRestartFile   7200
ResubmitOn              0
ResubmitCommand         my-scriptfile
TimeBegin   0.0
TimeMax     0.05
MaxSizeTimestep         0.005
MinSizeTimestep         1.0e-15
UnitLength_in_cm            3.085678e21
UnitMass_in_g               1.989e43
UnitVelocity_in_cm_per_s    1.0e5
GravityConstantInternal     0
ComovingIntegrationOn   0
BoxSize                 0.5
Omega0                  0.
OmegaLambda             0.
OmegaBaryon             0.
HubbleParam             1.
PartAllocFactor     3.0
MaxMemSize          4000
DomainBuild_ActiveFraction   0.005
InitGasTemp     0
MinGasTemp      1
DesNumNgb               32
MaxKernelRadius         1.0e10
MinGasKernelRadiusFractional    0
SofteningGas    1e-10
SofteningHalo   0.020
SofteningDisk   0.150
SofteningBulge  0.500
SofteningStars  0.01
SofteningBndry  0.01
SofteningGasMaxPhys     0.0005
SofteningHaloMaxPhys    0.010
SofteningDiskMaxPhys    0.075
SofteningBulgeMaxPhys   0.250
SofteningStarsMaxPhys   0.0005
SofteningBndryMaxPhys   0.0005
TurbDiffusionCoefficient 1.0
ErrTolTheta                  0.5
ErrTolForceAcc               0.0025
ErrTolIntAccuracy        0.01
CourantFac               0.1
MaxRMSDisplacementFac    0.125
MaxNumNgbDeviation      0.05
