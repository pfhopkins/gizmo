 #include "../core/proto.h"
 
 #ifdef ENERGY_BUDGET_DIAGNOSTIC
+/* Total gas energy by phase of the timestep. In an adiabatic run only the feedback injection
+   should change the total, so accumulation in any other phase localizes a numerical energy error
+   to a specific stage. Costs one MPI_Allreduce per mark, hence diagnostic-only. */
+static const char *EB_names[EB_NPHASE] = {"other","kick1","premerge","mergesplit","drift","grav","hydro","kick2","srcA","spawn","srcterms"};
+static double EB_phase[EB_NPHASE], EB_prev; static int EB_started = 0; static long EB_calls = 0;
+void energy_budget_mark(int phase)
+{
+    double loc = 0; int i;
+    for(i = 0; i < NumPart; i++)
+    {
+        if(P[i].Type == 0 && P[i].Mass > 0)
+        {
+            loc += P[i].Mass * (CellP[i].InternalEnergy + 0.5 * P[i].Vel.norm_sq() * All.cf_a2inv);
+        }
+    }
+    double e = 0; MPI_Allreduce(&loc, &e, 1, MPI_DOUBLE, MPI_SUM, MPI_COMM_WORLD);
+    if(EB_started && phase >= 0 && phase < EB_NPHASE) {EB_phase[phase] += e - EB_prev;}
+    EB_prev = e; EB_started = 1;
+}
+void energy_budget_report(void)
+{
+    if((++EB_calls % 200) != 0) {return;}
+    if(ThisTask != 0) {return;}
+    int k; double tot = 0; for(k = 0; k < EB_NPHASE; k++) {tot += EB_phase[k];}
+    /* CAVEAT: only phases bracketing an INSTANTANEOUS operation (mergesplit, spawn) mean anything --
+       across a drift or kick this sums particles at different kick times, so energy can appear to move
+       with no error present. Use the 'Energy (synced)' line below to test conservation. */
+    printf("Energy budget by phase [t=%.8g]:", All.Time);
+    for(k = 0; k < EB_NPHASE; k++) {printf(" %s=%.5e", EB_names[k], EB_phase[k]);}
+    printf(" | sum=%.5e\n", tot); fflush(stdout);
+}
+
