diff --git a/core/proto.h b/core/proto.h
index 8c45f0893..5b8b9c5d5 100644
--- a/core/proto.h
+++ b/core/proto.h
@@ -124,6 +124,32 @@ void powerspec_turb_save(char *fname, double *disp);
 void powerspec_turb_collect(void);
 void powerspec_turb(int filenr);
 void compute_additional_forces_for_all_particles(void);
+#if defined(ENERGY_LEDGER) && defined(LEDGER_TRACE_ID) /* trace one gas cell's wakeup checks and wakeup handling (ledger_trace_<task>.txt) */
+void ledger_trace(int i, const char *what, double a, double b, double c, double d);
+#define LEDGER_TRACE_(i, what, a, b, c, d) {if(P[(i)].ID == (MyIDType)(LEDGER_TRACE_ID)) {ledger_trace((i), (what), (a), (b), (c), (d));}}
+#else
+#define LEDGER_TRACE_(i, what, a, b, c, d)
+#endif
+#ifdef ENERGY_LEDGER
+/* Gas energy ledger (Template_Config.sh): every operation that changes gas kinetic (relative to the background shear
+   flow, in a shearing box) or thermal energy books its change to one channel; energy_ledger_report() compares the sum
+   with the measured change at full synchronizations, so any unbooked change shows up as the residual. */
+enum {LG_HYDRO_W, LG_HYDRO_Q, LG_HYDRO_LIMIT, LG_GRAV_W, LG_SHEAR_DRIFT, LG_RADP_LONG_W, LG_TURB_W,
+      LG_FB_KE, LG_FB_TE, LG_RADP_LOCAL, LG_HII_HEAT, LG_HII_RECOMB, LG_RAD_GAIN, LG_RAD_LOSS, LG_FLOORS, LG_SF_REMOVED,
+      LG_OUTFLOW, LG_MERGE_SPLIT, LG_N_CLOSURE, /* channels above enter the closure; below are diagnostics only */
+      LG_FB_INTENDED = LG_N_CLOSURE, LG_FB_DEFERRED, LG_N};
+extern double EnergyLedger[LG_N];
+#ifdef _OPENMP
+#define LEDGER_ADD(c, dE) do {double ledger_tmp_ = (dE); _Pragma("omp atomic") EnergyLedger[(c)] += ledger_tmp_;} while(0)
+#else
+#define LEDGER_ADD(c, dE) (EnergyLedger[(c)] += (dE))
+#endif
+Vec3<double> ledger_vrel(int i); /* physical velocity relative to the background flow */
+double ledger_specific_energy(int i); /* 0.5 v_rel^2 + u */
+double ledger_local_gas_energy(void);
+void energy_ledger_report(void);
+void ledger_log_hydro_event(int i, double dQ, double dW, double dt, int where); /* cells with a large single-step hydro energy change */
+#endif
 
 
 void set_cosmo_factors_for_current_time(void);
diff --git a/core/run.cc b/core/run.cc
index bf82f6e38..2e7106f1f 100644
--- a/core/run.cc
+++ b/core/run.cc
@@ -9,11 +9,86 @@
 #include "../declarations/allvars.h"
 #include "../core/proto.h"
 
+#ifdef ENERGY_LEDGER
+double EnergyLedger[LG_N];
+static const char *LedgerNames[LG_N] = {"hydro_W","hydro_Q","hydro_limit","grav_W","shear_drift","radP_long_W","turb_W",
+    "fb_KE","fb_TE","radP_local","HII_heat","HII_recomb","rad_gain","rad_loss","floors","SF_removed","outflow","merge_split","fb_intended","fb_deferred"};
+Vec3<double> ledger_vrel(int i)
+{
+    Vec3<double> v = P[i].Vel / All.cf_atime;
+#ifdef BOX_SHEARING
+    v[BOX_SHEARING_PHI_COORDINATE] += BOX_SHEARING_Q*BOX_SHEARING_OMEGA_BOX_CENTER*(P[i].Pos[0]-boxHalf_X);
+#endif
+    return v;
+}
+double ledger_specific_energy(int i) {return 0.5*ledger_vrel(i).norm_sq() + CellP[i].InternalEnergy;}
+double ledger_local_gas_energy(void) {double e=0; for(int i=0;i<NumPart;i++) {if(P[i].Type==0 && P[i].Mass>0) {e += P[i].Mass*ledger_specific_energy(i);}} return e;}
+#ifndef LEDGER_EVENT_THRESHOLD_1E51
+#define LEDGER_EVENT_THRESHOLD_1E51 (0.05)
+#endif
+/*! Log a gas cell whose single-step hydro energy change |dQ + dW| exceeds LEDGER_EVENT_THRESHOLD_1E51 (1e51 erg), to
+    ledger_events_<task>.txt: where = 0 kick thermal, 1 cooling-step thermal, 2 kick kinetic. */
+void ledger_log_hydro_event(int i, double dQ, double dW, double dt, int where)
+{
+    double u51 = 1.0e51/UNIT_ENERGY_IN_CGS;
+    if(fabs(dQ + dW) < LEDGER_EVENT_THRESHOLD_1E51*u51) {return;}
+    static FILE *fd = NULL;
+    if(!fd) {char fn[DEFAULT_PATH_BUFFERSIZE_TOUSE]; snprintf(fn, DEFAULT_PATH_BUFFERSIZE_TOUSE, "%sledger_events_%d.txt", All.OutputDir, ThisTask); fd = fopen(fn, "a");}
+    if(!fd) {return;}
+    Vec3<double> vr = ledger_vrel(i);
+    fprintf(fd, "%.10g %d %llu %.6g %.6g %.6g %.4g %.4g %.4g %.4g %.4g %.4g %d %.4g %.4g %.4g %.4g %.4g %.4g %.4g %.4g %.4g\n", All.Time, where, (unsigned long long) P[i].ID,
+        P[i].Pos[0], P[i].Pos[1], P[i].Pos[2], P[i].Mass, CellP[i].Density, CellP[i].InternalEnergy, dQ/u51, dW/u51, dt, P[i].TimeBin,
+        P[i].KernelRadius, P[i].NumNgb, CellP[i].MaxSignalVel, P[i].Particle_DivVel, CellP[i].HydroAccel.norm(), vr.norm(), CellP[i].ConditionNumber, CellP[i].temperature(), CellP[i].effective_soundspeed());
+    fflush(fd);
+}
+
+#if defined(ENERGY_LEDGER) && defined(LEDGER_TRACE_ID)
+void ledger_trace(int i, const char *what, double a, double b, double c, double d)
+{
+    static FILE *fd = NULL;
+    if(!fd) {char fn[DEFAULT_PATH_BUFFERSIZE_TOUSE]; snprintf(fn, DEFAULT_PATH_BUFFERSIZE_TOUSE, "%sledger_trace_%d.txt", All.OutputDir, ThisTask); fd = fopen(fn, "a");}
+    if(!fd) {return;}
+    fprintf(fd, "%.10g %s bin=%d active=%d dt=%.4g a=%.6g b=%.6g c=%.6g d=%.6g Ti_beg=%lld Ti_cur=%lld\n", All.Time, what, P[i].TimeBin, TimeBinActive[P[i].TimeBin],
+        get_particle_timestep_in_physical(i), a, b, c, d, (long long)P[i].Ti_begstep, (long long)P[i].Ti_current);
+    fflush(fd);
+}
+#endif
+
+/*! At full synchronizations (where Vel and InternalEnergy share a clock) write the gas kinetic+thermal energy, the
+    cumulative channels, and the residual = (E - E_0) - sum(closure channels) to energy_ledger.txt, in 1e51 erg. */
+void energy_ledger_report(void)
+{
+    if(All.HighestActiveTimeBin != All.HighestOccupiedTimeBin) {return;}
+    double loc[LG_N+2], glob[LG_N+2]; int i;
+    for(i=0;i<LG_N;i++) {loc[i] = EnergyLedger[i];}
+    loc[LG_N] = loc[LG_N+1] = 0;
+    for(i=0;i<NumPart;i++) {if(P[i].Type==0 && P[i].Mass>0) {loc[LG_N] += 0.5*P[i].Mass*ledger_vrel(i).norm_sq(); loc[LG_N+1] += P[i].Mass*CellP[i].InternalEnergy;}}
+    MPI_Reduce(loc, glob, LG_N+2, MPI_DOUBLE, MPI_SUM, 0, MPI_COMM_WORLD);
+    if(ThisTask != 0) {return;}
+    static FILE *fd = NULL; static double E0 = -1, L0[LG_N];
+    double u51 = 1.0e51/UNIT_ENERGY_IN_CGS, E = glob[LG_N]+glob[LG_N+1];
+    if(E0 < 0) {E0 = E; for(i=0;i<LG_N;i++) {L0[i] = glob[i];}} /* channels count from the first report, so restarts start clean */
+    if(!fd)
+    {
+        char fn[DEFAULT_PATH_BUFFERSIZE_TOUSE]; snprintf(fn, DEFAULT_PATH_BUFFERSIZE_TOUSE, "%senergy_ledger.txt", All.OutputDir);
+        fd = fopen(fn, "a");
+        if(fd) {fprintf(fd, "# gas energy ledger [1e51 erg], cumulative since the first report; residual = dE - sum(closure channels)\n# time E_kin E_th dE residual");
+                for(i=0;i<LG_N;i++) {fprintf(fd, " %s", LedgerNames[i]);} fprintf(fd, "\n");}
+    }
+    if(!fd) {return;}
+    double sum = 0; for(i=0;i<LG_N_CLOSURE;i++) {sum += glob[i]-L0[i];}
+    fprintf(fd, "%.10g %.6g %.6g %.6g %.6g", All.Time, glob[LG_N]/u51, glob[LG_N+1]/u51, (E-E0)/u51, ((E-E0)-sum)/u51);
+    for(i=0;i<LG_N;i++) {fprintf(fd, " %.6g", (glob[i]-L0[i])/u51);}
+    fprintf(fd, "\n"); fflush(fd);
+}
+#endif
+
